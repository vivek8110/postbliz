# ─────────────────────────────────────────────────────────────────────────
# Postbliz — environment variables
#
# 1. Copy this file to .env.local   (cp .env.example .env.local)
# 2. Fill in the values by following docs/self-hosting/env-setup.md
# 3. .env.local is gitignored. NEVER put real values in this file (.env.example).
#
# Grouped by the phase that first needs the variable, so you only sign up
# for what you're actually building. Phase 0 = local + database + auth + jobs
# + observability; everything below that can wait.
# ─────────────────────────────────────────────────────────────────────────

# ── Core secrets — generated locally, no account needed (Phase 0) ─────────
# openssl rand -base64 32   (run once per secret)
ENCRYPTION_KEY=            # 32-byte base64. Rotating this invalidates ALL stored OAuth tokens.
BETTER_AUTH_SECRET=        # 32-byte base64. Signs sessions.
BETTER_AUTH_URL=http://localhost:3000   # your app's base URL; prod = https://yourdomain.com

# ── Database — Neon Postgres (Phase 0) ────────────────────────────────────
# Two strings from ONE Neon project. Pooled for the app, direct for migrations.
DATABASE_URL=             # Neon POOLED connection string (app runtime, has -pooler in host)
DATABASE_URL_UNPOOLED=    # Neon DIRECT connection string (drizzle-kit migrations)

# ── Auth — Google OAuth (Phase 0) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Jobs — Trigger.dev v4 (Phase 0) ───────────────────────────────────────
TRIGGER_SECRET_KEY=       # dev key for local, prod key in your deploy env

# ── Observability (Phase 0) ───────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # use https://eu.i.posthog.com for EU

# ── Crawl + LLM + Storage (Phase 1) ───────────────────────────────────────
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=       # set a monthly spend cap in the OpenRouter dashboard on day one
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Publishing (Phase 2–3) ────────────────────────────────────────────────
POSTPEER_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=        # e.g. "postbliz/0.1 (by u/yourusername)" — must identify the app honestly
SHORTLINK_DOMAIN=         # domain for click-tracked short links, e.g. pblz.link

# ── Billing + Email (Phase 4) ─────────────────────────────────────────────
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
RESEND_API_KEY=
